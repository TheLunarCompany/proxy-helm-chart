{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "extraEnvVars": {
          "type": "array"
        },
        "mcpxVersion": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "hub": {
      "type": "object",
      "properties": {
        "extraEnvVars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "replicaCount": {
          "type": "integer"
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "staticOauth": {
          "type": "object",
          "description": "Static OAuth configuration for MCP server authentication. Maps domains to OAuth providers with credentials."
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "googleApplicationCredentials": {
          "type": "object",
          "description": "Optional secret-backed ADC file for auth-bff.",
          "properties": {
            "secretName": {
              "type": "string",
              "default": ""
            },
            "secretKey": {
              "type": "string",
              "default": "credentials.json"
            }
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "properties": {
            "kubernetes.io/ingress.global-static-ip-name": {
              "type": "string"
            }
          }
        },
        "domains": {
          "type": "object",
          "properties": {
            "hub": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "webserver": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "gce": {
          "type": "object"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "description": "Embedded ClickHouse for event store analytics",
      "if": {
        "properties": {
          "enabled": { "const": true }
        },
        "required": ["enabled"]
      },
      "then": {
        "properties": {
          "credentialsSecret": { "minLength": 1 }
        },
        "required": ["credentialsSecret"]
      },
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable embedded ClickHouse StatefulSet",
          "default": false
        },
        "credentialsSecret": {
          "type": "string",
          "description": "Name of the K8s secret containing CLICKHOUSE_USER and CLICKHOUSE_PASSWORD. Required when enabled is true.",
          "default": ""
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "labels": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "accessModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "storageClassName": {
              "type": "string",
              "default": ""
            },
            "size": {
              "type": "string",
              "default": "10Gi"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "memory": {
                  "type": "string"
                },
                "cpu": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": {
                  "type": "string"
                },
                "cpu": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "jobs": {
      "type": "object",
      "properties": {
        "admin": {
          "type": "object",
          "description": "Admin job settings for DB migration management",
          "properties": {
            "rollbackMigrationName": {
              "type": "string",
              "description": "Target migration name for rollback. Leave empty unless explicitly instructed otherwise. When empty, rollback targets the latest applied migration.",
              "default": ""
            },
            "resolveMigrationName": {
              "type": "string",
              "description": "Target migration name for resolve-failed. Leave empty unless explicitly instructed otherwise. When empty, resolves the latest failed migration.",
              "default": ""
            },
            "catalogItemStore": {
              "type": "object",
              "description": "Catalog Item Store jobs settings",
              "properties": {
                "catalogItemNames": {
                  "type": "array",
                  "description": "Catalog item names for populate/fix jobs.",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "forceOverride": {
                  "type": "boolean",
                  "description": "Set to true to force-override existing config in fix job. Default merges non-destructively.",
                  "default": false
                }
              }
            }
          }
        }
      }
    },
    "hibernation": {
      "type": "object",
      "properties": {
        "cronSchedule": {
          "type": "string",
          "description": "Cron schedule for the scheduled hibernation job. Leave empty to disable the CronJob.",
          "default": ""
        },
        "idleMinutes": {
          "type": "integer",
          "description": "Idle window in minutes. Instances with no real usage for this long are hibernated. 0 disables idle hibernation; any value > 0 also turns HIBERNATION_ENABLED on. Apart from 0, the effective minimum is 3: values of 1 or 2 are clamped up to 3.",
          "default": 0,
          "minimum": 0
        }
      }
    },
    "auditLog": {
      "type": "object",
      "properties": {
        "pruneCronSchedule": {
          "type": "string",
          "description": "Cron schedule for the audit-log pruning job. Enabled by default (daily at noon). Leave empty to disable the CronJob.",
          "default": "0 12 * * *"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "description": "Delete audit_logs rows older than this many days. 0 disables pruning.",
          "default": 60
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "mcpxRuntimeAuth": {
          "type": "object",
          "description": "Runtime auth/config files injected into each MCPX instance pod",
          "properties": {
            "dockerConfigSecret": {
              "type": "string",
              "description": "Name of a kubernetes.io/dockerconfigjson secret exposed to Docker inside MCPX"
            },
            "fsGroup": {
              "type": "integer",
              "description": "Group ID used to read mounted MCPX runtime auth secrets",
              "default": 1002
            },
            "npmrcSecret": {
              "type": "string",
              "description": "Name of a secret containing a .npmrc key exposed to npm/npx"
            },
            "uvConfigSecret": {
              "type": "string",
              "description": "Name of a secret containing a uv.toml key exposed to uv/uvx"
            },
            "netrcSecret": {
              "type": "string",
              "description": "Name of a secret containing a .netrc key exposed through NETRC"
            },
            "decodeBase64": {
              "type": "boolean",
              "default": false,
              "description": "If true, runtime-auth secret values are expected to be base64-encoded and decoded at pod startup via an init container"
            }
          }
        },
        "mcpxCRD": {
          "type": "object",
          "description": "Configuration for CRD schema version checks",
          "properties": {
            "schemaVersionStrictCheck": {
              "type": "boolean",
              "description": "Enable strict schema version checking",
              "default": true
            },
            "schemaExpectedVersion": {
              "type": "string",
              "description": "Expected CRD schema version",
              "default": "1"
            }
          }
        },
        "affinity": {
          "type": "object",
          "description": "Affinity for the controller's own pod"
        },
        "topologySpreadConstraints": {
          "type": "array",
          "description": "Topology spread constraints for the controller's own pod"
        },
        "priorityClassName": {
          "type": "string",
          "description": "priorityClassName for the controller's own pod"
        },
        "mcpxNodeSelector": {
          "type": "object",
          "description": "NodeSelector applied to every MCPX instance pod created by the controller"
        },
        "mcpxTolerations": {
          "type": "array",
          "description": "Tolerations applied to every MCPX instance pod created by the controller"
        },
        "mcpxAffinity": {
          "type": "object",
          "description": "Affinity applied to every MCPX instance pod created by the controller"
        },
        "mcpxTopologySpreadConstraints": {
          "type": "array",
          "description": "Topology spread constraints applied to every MCPX instance pod created by the controller"
        },
        "mcpxPriorityClassName": {
          "type": "string",
          "description": "priorityClassName applied to every MCPX instance pod created by the controller"
        }
      }
    },
    "webserver": {
      "type": "object",
      "properties": {
        "extraEnvVars": {
          "type": "array"
        },
        "sandboxAnalysis": {
          "type": "object",
          "description": "Sandbox Analysis LLM configuration. For API key, add a secret with SANDBOX_ANALYSIS_LLM_API_KEY and list it in extraEnvFromSecrets",
          "properties": {
            "llmProvider": {
              "type": "string",
              "description": "LLM provider for Sandbox Analysis",
              "enum": ["openai", "google-gen-ai"]
            },
            "llmModel": {
              "type": "string",
              "description": "LLM model name for Sandbox Analysis"
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "replicaCount": {
          "type": "integer"
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    }
  }
}

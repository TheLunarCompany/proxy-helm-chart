{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "extraEnvVars": {
          "type": "array"
        },
        "mcpxVersion": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "hub": {
      "type": "object",
      "properties": {
        "extraEnvVars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "replicaCount": {
          "type": "integer"
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "googleApplicationCredentials": {
          "type": "object",
          "description": "Optional secret-backed ADC file for auth-bff.",
          "properties": {
            "secretName": {
              "type": "string",
              "default": ""
            },
            "secretKey": {
              "type": "string",
              "default": "credentials.json"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object",
          "properties": {
            "kubernetes.io/ingress.global-static-ip-name": {
              "type": "string"
            }
          }
        },
        "domains": {
          "type": "object",
          "properties": {
            "hub": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "webserver": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "gce": {
          "type": "object"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "jobs": {
      "type": "object",
      "properties": {
        "admin": {
          "type": "object",
          "description": "Admin job settings for DB migration management",
          "properties": {
            "rollbackMigrationName": {
              "type": "string",
              "description": "Target migration name for rollback. Leave empty unless explicitly instructed otherwise. When empty, rollback targets the latest applied migration.",
              "default": ""
            },
            "resolveMigrationName": {
              "type": "string",
              "description": "Target migration name for resolve-failed. Leave empty unless explicitly instructed otherwise. When empty, resolves the latest failed migration.",
              "default": ""
            }
          }
        }
      }
    },
    "hibernation": {
      "type": "object",
      "properties": {
        "cronSchedule": {
          "type": "string",
          "description": "Cron schedule for the scheduled hibernation job. Leave empty to disable the CronJob.",
          "default": ""
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "mcpxRuntimeAuth": {
          "type": "object",
          "description": "Runtime auth/config files injected into each MCPX instance pod",
          "properties": {
            "dockerConfigSecret": {
              "type": "string",
              "description": "Name of a kubernetes.io/dockerconfigjson secret exposed to Docker inside MCPX"
            },
            "npmrcSecret": {
              "type": "string",
              "description": "Name of a secret containing a .npmrc key exposed to npm/npx"
            },
            "uvConfigSecret": {
              "type": "string",
              "description": "Name of a secret containing a uv.toml key exposed to uv/uvx"
            },
            "netrcSecret": {
              "type": "string",
              "description": "Name of a secret containing a .netrc key exposed through NETRC"
            }
          }
        },
        "mcpxCRD": {
          "type": "object",
          "description": "Configuration for CRD schema version checks",
          "properties": {
            "schemaVersionStrictCheck": {
              "type": "boolean",
              "description": "Enable strict schema version checking",
              "default": true
            },
            "schemaExpectedVersion": {
              "type": "string",
              "description": "Expected CRD schema version",
              "default": "1"
            }
          }
        }
      }
    },
    "webserver": {
      "type": "object",
      "properties": {
        "extraEnvVars": {
          "type": "array"
        },
        "sandboxAnalysis": {
          "type": "object",
          "description": "Sandbox Analysis LLM configuration. For API key, add a secret with SANDBOX_ANALYSIS_LLM_API_KEY and list it in extraEnvFromSecrets",
          "properties": {
            "llmProvider": {
              "type": "string",
              "description": "LLM provider for Sandbox Analysis",
              "enum": ["openai", "google-gen-ai"]
            },
            "llmModel": {
              "type": "string",
              "description": "LLM model name for Sandbox Analysis"
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "replicaCount": {
          "type": "integer"
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}

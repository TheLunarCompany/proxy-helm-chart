{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "controller_domain": {
            "type": "string"
        },
        "crds": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "domain": {
            "type": "string"
        },
        "global": {
            "type": "object",
            "properties": {
                "logLevel": {
                    "type": "string"
                },
                "controllerToken": {
                    "type": "string"
                },
                "hubUrl": {
                    "type": "string"
                },
                "imagePullSecrets": {
                    "type": "array"
                },
                "oidc": {
                    "type": "object",
                    "properties": {
                        "clientId": {
                            "type": "string"
                        },
                        "clientSecret": {
                            "type": "string"
                        },
                        "issuerUrl": {
                            "type": "string"
                        },
                        "sessionSecret": {
                            "type": "string"
                        }
                    }
                },
                "redis": {
                    "type": "object",
                    "properties": {
                        "deploy": {
                            "type": "boolean"
                        },
                        "isCluster": {
                            "type": "boolean"
                        },
                        "prefix": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "hiveController": {
            "type": "object",
            "properties": {
                "affinity": {
                    "type": "object"
                },
                "autoscaling": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "controllerTokenSecret": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "env": {
                    "type": "object",
                    "properties": {
                        "LOG_LEVEL": {
                            "type": "string"
                        },
                        "MCPX_API_VERSION": {
                            "type": "string"
                        },
                        "MCPX_KIND": {
                            "type": "string"
                        },
                        "PORT": {
                            "type": "integer"
                        },
                        "ROUTER_DOMAIN": {
                            "type": "string"
                        }
                    }
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "pullPolicy": {
                            "type": "string"
                        },
                        "repository": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "imagePullSecrets": {
                    "type": "array"
                },
                "nodeSelector": {
                    "type": "object"
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "fsGroup": {
                            "type": "integer"
                        },
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "runAsUser": {
                            "type": "integer"
                        }
                    }
                },
                "probes": {
                    "type": "object",
                    "properties": {
                        "livenessProbe": {
                            "type": "object",
                            "properties": {
                                "httpGet": {
                                    "type": "object",
                                    "properties": {
                                        "path": {
                                            "type": "string"
                                        },
                                        "port": {
                                            "type": "integer"
                                        }
                                    }
                                },
                                "initialDelaySeconds": {
                                    "type": "integer"
                                },
                                "periodSeconds": {
                                    "type": "integer"
                                }
                            }
                        },
                        "readinessProbe": {
                            "type": "object",
                            "properties": {
                                "httpGet": {
                                    "type": "object",
                                    "properties": {
                                        "path": {
                                            "type": "string"
                                        },
                                        "port": {
                                            "type": "integer"
                                        }
                                    }
                                },
                                "initialDelaySeconds": {
                                    "type": "integer"
                                },
                                "periodSeconds": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                },
                "rbac": {
                    "type": "object",
                    "properties": {
                        "create": {
                            "type": "boolean"
                        }
                    }
                },
                "replicaCount": {
                    "type": "integer"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "securityContext": {
                    "type": "object",
                    "properties": {
                        "runAsNonRoot": {
                            "type": "boolean"
                        },
                        "runAsUser": {
                            "type": "integer"
                        }
                    }
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "port": {
                            "type": "integer"
                        },
                        "targetPort": {
                            "type": "integer"
                        },
                        "type": {
                            "type": "string"
                        }
                    }
                },
                "serviceAccount": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object"
                        },
                        "create": {
                            "type": "boolean"
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "tolerations": {
                    "type": "array"
                }
            }
        },
        "ingress": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "annotations": { "type": "object" },
                "domains": {
                    "type": "object",
                    "properties": {
                        "controller": { "$ref": "#/$defs/domainSpec" },
                        "router": { "$ref": "#/$defs/domainSpec" },
                        "ui": { "$ref": "#/$defs/domainSpec" }
                    }
                },
                "gcp": {
                    "type": "object",
                    "properties": {
                        "staticIPName": {
                            "type": "string"
                        }
                    }
                },
                "aws": {
                    "type": "object",
                    "properties": {
                        "loadBalancerType": {
                            "type": "string",
                            "enum": ["nlb", "alb"]
                        },
                        "securityGroups": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "subnets": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "elasticIPs": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "certificateArn": {
                            "type": "string"
                        }
                    }
                },
                "azure": {
                    "type": "object",
                    "properties": {
                        "applicationGatewayName": {
                            "type": "string"
                        },
                        "resourceGroup": {
                            "type": "string"
                        },
                        "subscriptionId": {
                            "type": "string"
                        },
                        "staticIP": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "router_domain": {
            "type": "string"
        },
        "ui_domain": {
            "type": "string"
        }
    },
    "$defs": {
        "domainSpec": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "host": { "type": "string" },
                    "paths": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "path": { "type": "string" },
                                "pathType": { "type": "string" },
                                "backend": {
                                    "type": "object",
                                    "properties": {
                                        "serviceName": { "type": "string" },
                                        "servicePort": { "type": "integer" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "router": {
        "type": "object",
        "properties": {
            "redis": {
                "type": "object",
                "properties": {
                    "isCluster": {
                        "type": "boolean"
                    },
                    "url": {
                        "type": "string"
                    }
                }
            }
        }
    }
}

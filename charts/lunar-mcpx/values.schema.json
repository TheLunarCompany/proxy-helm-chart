{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "description": "Number of replicas to run",
      "default": 1
    },
    "logLevel": {
      "type": "string",
      "description": "Log level for the app",
      "default": "info",
      "enum": ["error", "warn", "info", "http", "verbose", "debug", "silly"]
    },
    "metrics": {
      "type": "object",
      "description": "Metrics configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable metrics collection and endpoint",
          "default": true
        },
        "port": {
          "type": "integer",
          "description": "Port for metrics endpoint",
          "default": 3000
        }
      },
      "required": ["enabled", "port"]
    },
    "dockerInDocker": {
      "type": "object",
      "description": "Configuration for Docker-in-Docker support",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Docker-in-Docker support",
          "default": false
        }
      },
      "required": ["enabled"]
    },
    "config": {
      "type": "object",
      "description": "Inline application configuration files",
      "properties": {
        "mcpJson": {
          "type": "string",
          "description": "Content of mcp.json"
        },
        "appYaml": {
          "type": "string",
          "description": "content of app.yaml"
        }
      }
    },
    "secretRef": {
      "type": "object",
      "description": "Reference to a Kubernetes Secret that provides credentials and tokens",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the Kubernetes Secret"
        },
        "keys": {
          "type": "array",
          "description": "List of secret keys to mount as environment variables",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["name"]
    }
  },
  "required": ["replicaCount"]
}
